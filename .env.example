# Copy to .env and fill in. Never commit .env.

# --- Gemini ---
GEMINI_API_KEY=your-key-here
# Use whichever model your professor's starter code uses:
GEMINI_MODEL=gemini-2.5-flash

# --- Database (optional) ---
SYLLABUDDY_DB=syllabuddy.db

# --- Weekly email (SMTP). For Gmail: smtp.gmail.com, port 587, and an "App Password" ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Syllabuddy <you@gmail.com>

# Link used inside the emails
APP_URL=http://localhost:5000
